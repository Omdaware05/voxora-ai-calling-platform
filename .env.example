# Voxora environment — copy to .env and fill in real values.
# NEVER commit a real .env. All values below are placeholders/examples only.

# --- Core ---
# Random 32+ byte string. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local dev (sqlite fallback): DATABASE_URL=sqlite:///./voxora.db
DATABASE_URL=postgresql+psycopg2://voxora:voxora@postgres:5432/voxora
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=false
# If true, FastAPI creates tables on startup (dev only). In compose the
# entrypoint runs `alembic upgrade head` instead — leave false in prod.
AUTO_CREATE_TABLES=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=15

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=voxora
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=voxora

# --- Storage (recordings, imports/exports) ---
STORAGE_BACKEND=local            # local | minio
DATA_DIR=./data
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=voxora-recordings
MINIO_SECURE=false
# MinIO server root credentials (docker-compose.yml)
MINIO_ROOT_USER=voxoraadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password

# --- Dograh (voice-agent orchestration) ---
# Leave DOGRAH_BASE_URL empty to run in mock mode (no live voice pipeline).
DOGRAH_BASE_URL=
DOGRAH_API_KEY=change-me-dograh-api-key
DOGRAH_MPS_KEY=change-me-dograh-mps-key

# --- VoBiz (telephony provider) ---
# Leave empty if not making real calls; the UI stores per-tenant VoBiz
# credentials (encrypted) via /api/v1/telephony.
VOBIZ_AUTH_ID=change-me-vobiz-auth-id
VOBIZ_AUTH_TOKEN=change-me-vobiz-auth-token
VOBIZ_FROM_NUMBER=+911234567890
VOBIZ_API_URL=

# --- AI models ---
# Defaults mirror app defaults; leave empty to use the UI's per-tenant
# model config (encrypted keys, test-connection checks).
WHISPER_STT_URL=
WHISPER_MODEL=whisper-large-v3-turbo
LLM_BASE_URL=
LLM_MODEL=
KOKORO_TTS_URL=
KOKORO_MODEL=kokoro
KOKORO_VOICE=
COST_PER_MIN=0.05

# --- Frontend (build-time) ---
# Defaults to /api (same-origin) when unset — the compose nginx proxies /api/.
VITE_API_URL=/api
